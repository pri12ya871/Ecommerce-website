{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
  "outputDirectory": "frontend/build",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__vpath=/api/$1" },
    { "source": "/send-text", "destination": "/api/index?__vpath=/send-text" },
    { "source": "/((?!api/|send-text).*)", "destination": "/index.html" }
  ]
}
